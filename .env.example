# Local development: explicit loopback-only demonstration authentication.
APP_ENV=development
AUTH_MODE=demo
BIND_HOST=127.0.0.1
DATABASE_PATH=data/identity-risk.db
COOKIE_SECURE=false
FRONTEND_URL=http://127.0.0.1:5173
OIDC_REDIRECT_URI=http://127.0.0.1:8021/api/auth/callback
# For production compose: HTTPS URLs, a real OIDC client, secure cookies.
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ROLE_CLAIM=realm_access.roles
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
MAX_UPLOAD_BYTES=5242880
SESSION_TTL_SECONDS=28800
